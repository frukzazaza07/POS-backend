APP_PORT=4000
APP_ENV=development

# PostgreSQL
# If DATABASE_URL is set, it takes priority over the individual DB_* vars below.
DATABASE_URL=postgres://postgres:password@localhost:5432/pos_db?sslmode=disable

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=pos_db
DB_SSLMODE=disable

# JWT (change in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Inventory system connection
INVENTORY_BASE_URL=http://localhost:3000
INVENTORY_API_KEY=dev-pos-api-key-2026
INVENTORY_WEBHOOK_SECRET=your-webhook-hmac-secret

# Set to false in production
SEED=true
